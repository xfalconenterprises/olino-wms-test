# Copy to backend/.env and fill in real values. Never commit .env.

# PostgreSQL connection. The values below match docker-compose.yml (development only).
# On the server, use a dedicated database user with a strong password.
DATABASE_URL="postgresql://olino:olinowms2024@localhost:5432/olino_wms"

# Signs login tokens. Required. On the server use a long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret

# Port the app (API + screens) listens on
PORT=4000

NODE_ENV=development
